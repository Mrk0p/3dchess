# Public Supabase URL; required in browser code
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public publishable key; safe to expose when RLS and policies are configured
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secret key. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional: URL for Supabase Auth JWKS; not currently required by multiplayer routes
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
